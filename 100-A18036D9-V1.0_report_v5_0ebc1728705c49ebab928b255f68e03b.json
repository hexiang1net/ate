{"type":"assistant","message":{"id":"b7fdf7ef-9494-4b43-8060-94fc69004a15","type":"message","role":"assistant","model":"deepseek-v4-pro","content":[{"type":"tool_use","id":"call_00_IrvSC0e0m2KVC4TRYfrr1069","name":"Write","input":{"file_path":"D:\\agent\\ate\\build_seq_from_xlsx.py","content":"\"\"\"从 Excel 文件生成 TestStand .seq 序列文件\"\"\"\nimport sys, os\nsys.path.insert(0, r'D:\\agent\\ate\\teststand-2012-mcp')\n\nimport openpyxl\nfrom sequence_builder import SequenceBuilder\n\nXLSX_PATH = r'D:\\agent\\ate\\100-A18036D9-V1.0_report_v5_0ebc1728705c49ebab928b255f68e03b.xlsx'\nSEQ_OUTPUT = r'D:\\agent\\ate\\100-A18036D9-V1.0_report_v5_0ebc1728705c49ebab928b255f68e03b.seq'\n\n\ndef parse_limits(limits_str):\n    \"\"\"解析 limits 字符串, 返回 (low, high, comp, limit_expr)\"\"\"\n    if not limits_str:\n        return None, None, None, None\n    s = limits_str.strip()\n    # \"4.50<=x<=5.50\" 格式\n    if '<=' in s and '<=x<=' in s:\n        parts = s.split('<=x<=')\n        if len(parts) == 2:\n            return float(parts[0]), float(parts[1]), None, None\n    # \"x==0xaa\" 格式 (hex comparison)\n    if s.startswith('x=='):\n        return None, None, 'EQ', s[3:]\n    # 其他格式尝试\n    if '<=' in s:\n        parts = s.split('<=')\n        if len(parts) == 2:\n            try:\n                return None, float(parts[1]), 'LE', None\n            except ValueError:\n                pass\n    return None, None, None, None\n\n\ndef parse_settings(settings_str):\n    \"\"\"解析 settings 字符串, 返回属性字典\"\"\"\n    props = {}\n    if not settings_str:\n        return props\n    for item in settings_str.split(';'):\n        item = item.strip()\n        if '=' in item:\n            key, val = item.split('=', 1)\n            props[key.strip()] = val.strip()\n    return props\n\n\ndef build_sequence():\n    wb = openpyxl.load_workbook(XLSX_PATH)\n    ws = wb['ATE test item check list']\n    var_ws = wb['Variables']\n\n    # ── 读取所有步骤行 ──\n    rows = []\n    for row in ws.iter_rows(min_row=5, max_row=ws.max_row, values_only=True):\n        if row[0] is None:\n            continue\n        rows.append(row)\n\n    # ── 解析步骤 ──\n    class Step:\n        def __init__(self, row_data):\n            self.step_no = str(row_data[0]).strip() if row_data[0] else ''\n            self.group = str(row_data[1]).strip() if row_data[1] else 'main'\n            self.name = str(row_data[2]).strip() if row_data[2] else ''\n            self.step_type = str(row_data[3]).strip() if row_data[3] else ''\n            self.vi = str(row_data[4]).strip() if row_data[4] else None\n            self.limits = row_data[5]\n            self.unit = str(row_data[6]).strip() if row_data[6] else None\n            self.fmt = str(row_data[7]).strip() if row_data[7] else None\n            self.run_mode = str(row_data[8]).strip() if row_data[8] else None\n            self.wait = row_data[9]\n            self.adapter = str(row_data[10]).strip() if row_data[10] else None\n            self.additional = str(row_data[11]).strip() if row_data[11] else None\n            self.settings_str = str(row_data[12]).strip() if row_data[12] else None\n            self.comment = str(row_data[13]).strip() if row_data[13] else None\n\n        @property\n        def level(self):\n            return len(self.step_no.split('_'))\n\n        @property\n        def parent_key(self):\n            parts = self.step_no.split('_')\n            if len(parts) >= 3:\n                return '_'.join(parts[:-1])\n            return None\n\n        def __repr__(self):\n            return f\"Step({self.step_no}, {self.name}, {self.step_type})\"\n\n    all_steps = [Step(row) for row in rows]\n\n    # 构建层级: 二级步骤在最外层, 三级步骤归属到父步骤\n    step_map = {s.step_no: s for s in all_steps}\n    root_steps = []\n    for s in all_steps:\n        if s.level <= 2:\n            root_steps.append(s)\n\n    for s in all_steps:\n        if s.level == 3:\n            parent_key = s.parent_key\n            if parent_key in step_map:\n                parent = step_map[parent_key]\n                if not hasattr(parent, 'children'):\n                    parent.children = []\n                parent.children.append(s)\n    for s in all_steps:\n        if not hasattr(s, 'children'):\n            s.children = []\n\n    # ── 创建 Builder ──\n    builder = SequenceBuilder()\n    builder.create_file()\n\n    # ── 添加全局变量 ──\n    print(\"Adding global variables...\")\n    for row in var_ws.iter_rows(min_row=2, max_row=var_ws.max_row, values_only=True):\n        container, var_name, value, var_type = row\n        if container is None or var_name is None:\n            continue\n        if container == 'FileGlobals':\n            default_val = str(value) if value is not None else ''\n            if var_type == 'Boolean':\n                default_val = str(value) if value is not None else 'False'\n            try:\n                builder.add_file_global(var_name, var_type or 'String', default_val)\n            except Exception as e:\n                print(f\"  Warning: Failed to add global {var_name}: {e}\")\n\n    # ── 辅助函数: 将 Step 转换为 builder 调用 ──\n    def add_step(builder, step, seq_name='MainSequence'):\n        builder.use_sequence(seq_name)\n        group = 'setup' if step.group == 'startup' else 'main'\n        builder.set_sequence_step_group(group)\n\n        st = step.step_type\n\n        # 解析 settings\n        props = parse_settings(step.settings_str)\n\n        # 处理 SequenceCall: 创建子序列并递归添加子步骤\n        if st == 'SequenceCall' and step.children:\n            sub_seq_name = step.name\n            print(f\"  Creating sub-sequence: {sub_seq_name} ({len(step.children)} steps)\")\n            builder.add_sequence(sub_seq_name)\n            for child in step.children:\n                add_step(builder, child, sub_seq_name)\n            # 在主序列添加 SequenceCall\n            builder.use_sequence(seq_name)\n            builder.set_sequence_step_group('main')\n            builder.add_sequence_call(sub_seq_name, name=step.name)\n            return\n\n        # NI_Wait 步骤\n        if st == 'NI_Wait':\n            wait_sec = float(step.wait) if step.wait else 0.1\n            builder.add_wait(wait_sec, name=step.name)\n            return\n\n        # NumericLimitTest 步骤\n        if st == 'NumericLimitTest':\n            low, high, comp, limit_expr = parse_limits(step.limits)\n\n            # 设置模块路径\n            if step.vi:\n                props['ModulePath'] = step.vi\n\n            # 设置 limits\n            if low is not None and high is not None:\n                props['Limits.Low'] = str(low)\n                props['Limits.High'] = str(high)\n            elif comp and limit_expr:\n                props['Comp'] = comp\n                if limit_expr:\n                    # hex comparison\n                    props['Limits.String'] = limit_expr\n\n            # 单位和格式\n            if step.unit:\n                props['Limits.Unit'] = step.unit\n            if step.fmt:\n                props['DataFormat'] = step.fmt\n\n            # 额外结果\n            if step.additional:\n                try:\n                    # additional results 格式: \"AR.Parms[4](Data out).CheckedState=2\"\n                    for part in step.additional.split(','):\n                        part = part.strip()\n                        if part:\n                            props[part] = ''  # 简单标记\n                except:\n                    pass\n\n            builder.add_step(st, name=step.name, adapter=step.adapter, **props)\n            return\n\n        # Action / PassFailTest 步骤\n        if st in ('Action', 'PassFailTest'):\n            if step.vi:\n                props['ModulePath'] = step.vi\n            builder.add_step(st, name=step.name, adapter=step.adapter, **props)\n            return\n\n        # 流程控制: If, Else, End\n        if st in ('NI_Flow_If', 'NI_Flow_Else', 'NI_Flow_End'):\n            builder.add_step(st, name=step.name, adapter=step.adapter, **props)\n            return\n\n        # 其他步骤类型 - 通用处理\n        if step.vi:\n            props['ModulePath'] = step.vi\n        if step.limits and step.step_type not in ('NumericLimitTest',):\n            # 非 NumericLimitTest 但有 limits\n            low, high, comp, limit_expr = parse_limits(step.limits)\n            if low is not None and high is not None:\n                props['Limits.Low'] = str(low)\n                props['Limits.High'] = str(high)\n        if step.unit:\n            props['Limits.Unit'] = step.unit\n        if step.fmt:\n            props['DataFormat'] = step.fmt\n\n        builder.add_step(st, name=step.name, adapter=step.adapter, **props)\n\n    # ── 处理所有顶层步骤 ──\n    print(f\"\\nProcessing {len(root_steps)} root steps...\")\n    for step in root_steps:\n        print(f\"  {step.step_no}: {step.name} [{step.step_type}]\")\n        try:\n            add_step(builder, step, 'MainSequence')\n        except Exception as e:\n            print(f\"    ERROR: {e}\")\n            import traceback\n            traceback.print_exc()\n\n    # ── 保存 ──\n    print(f\"\\nSaving to: {SEQ_OUTPUT}\")\n    builder.save(SEQ_OUTPUT)\n    builder.close()\n    print(\"Done!\")\n\n\nif __name__ == '__main__':\n    build_sequence()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":118,"cache_creation_input_tokens":0,"cache_read_input_tokens":76416,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"19af999b-02ed-435e-979f-281cde129ae4","uuid":"dcbce1f2-c1b6-43c4-a01c-8c9772718b9d"}
