ression\"],\n244\t            },\n245\t        ),\n246\t        Tool(\n247\t            name=\"ts_add_wait\",\n248\t            description=\"添加等待步骤。暂停执行指定秒数。\",\n249\t            inputSchema={\n250\t                \"type\": \"object\",\n251\t                \"properties\": {\n252\t                    \"seconds\": {\n253\t                        \"type\": \"number\",\n254\t                        \"description\": \"等待时间（秒）\",\n255\t                    },\n256\t                    \"name\": {\n257\t                        \"type\": \"string\",\n258\t                        \"description\": \"步骤名称（可选，默认 'Wait'）\",\n259\t                    },\n260\t                },\n261\t                \"required\": [\"seconds\"],\n262\t            },\n263\t        ),\n264\t\n265\t        # ── 序列操作 ──\n266\t        Tool(\n267\t            name=\"ts_set_step_group\",\n268\t            description=\"设置后续 ts_add_step 操作的目标步骤组。TestStand 每个序列有三个步骤组: Setup（初始化）、Main（主体测试）、Cleanup（清理）。默认在 Main 组中操作。\",\n269\t            inputSchema={\n270\t                \"type\": \"object\",\n271\t                \"properties\": {\n272\t                    \"group\": {\n273\t                        \"type\": \"string\",\n274\t                        \"description\": \"步骤组名: setup / main / cleanup\",\n275\t                    },\n276\t                },\n277\t                \"required\": [\"group\"],\n278\t            },\n279\t        ),\n280\t        Tool(\n281\t            name=\"ts_add_sequence\",\n282\t            description=\"向当前序列文件添加一个新的子序列。可用于封装可复用的测试逻辑。\",\n283\t            inputSchema={\n284\t                \"type\": \"object\",\n285\t                \"properties\": {\n286\t                    \"name\": {\n287\t                        \"type\": \"string\",\n288\t                        \"description\": \"子序列名称\",\n289\t                    },\n290\t                },\n291\t                \"required\": [\"name\"],\n292\t            },\n293\t        ),\n294\t        Tool(\n295\t            na