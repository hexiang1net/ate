序列文件引用\"\"\"\n52\t        if self._seq_file is not None:\n53\t            self._engine.release_sequence_file(self._seq_file)\n54\t            self._seq_file = None\n55\t        return self\n56\t\n57\t    # ── 序列级操作 ──\n58\t\n59\t    def get_main_sequence(self):\n60\t        \"\"\"获取 MainSequence\"\"\"\n61\t        self._ensure_file()\n62\t        return self._seq_file.GetSequenceByName(\"MainSequence\")\n63\t\n64\t    def add_sequence(self, name: str) -> \"SequenceBuilder\":\n65\t        \"\"\"添加新的子序列\"\"\"\n66\t        self._ensure_file()\n67\t        seq = self._engine.new_sequence()\n68\t        seq.Name = name\n69\t        self._seq_file.InsertSequenceEx(\n70\t            self._seq_file.NumSequences, seq\n71\t        )\n72\t        self._step_counts[name] = {0: 0, 1: 0, 2: 0}\n73\t        return self\n74\t\n75\t    def set_sequence_step_group(self, step_group: str) -> \"SequenceBuilder\":\n76\t        \"\"\"设置后续 add_step 操作的目标步骤组: setup/main/cleanup\"\"\"\n77\t        if step_group not in STEP_GROUP_NAMES:\n78\t            raise ValueError(f\"无效步骤组: {step_group}，可选: setup/main/cleanup\")\n79\t        self._current_step_group = STEP_GROUP_NAMES[step_group]\n80\t        return self\n81\t\n82\t    def use_sequence(self, sequence_name: str) -> \"SequenceBuilder\":\n83\t        \"\"\"切换到指定序列进行后续操作\"\"\"\n84\t        self._current_sequence = sequence_name\n85\t        return self\n86\t\n87\t    # ── 步骤操作 ──\n88\t\n89\t    def add_step(\n90\t        self,\n91\t        step_type: str,\n92\t        name: Optional[str] = None,\n93\t        adapter: Optional[str] = None,\n94\t        **properties,\n95\t    ) -> \"SequenceBuilder\":\n96\t        \"\"\"添加步骤到当前序列的当前步骤组\n97\t\n98\t        Args:\n99\t            step_type: 步骤类型名 (如 Action, NumericLimitTest, MessagePopup)\n100\t            name: 步骤名称（可选，自动生成默认名称）\n101\t            adapter: 适配器名（可选，根据步骤类型自动选择）\n102\t            **properties: 步骤属性，键值对\n103\t        \"\"\"\n104\t        self._ensure_file()\n105\t\n106\t        # 解析