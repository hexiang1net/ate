              \"type\": \"string\",\n57\t                        \"description\": \"序列文件路径（.seq）\",\n58\t                    },\n59\t                },\n60\t                \"required\": [\"path\"],\n61\t            },\n62\t        ),\n63\t        Tool(\n64\t            name=\"ts_save_sequence_file\",\n65\t            description=\"保存当前序列文件到指定路径。保存后仍可继续编辑。\",\n66\t            inputSchema={\n67\t                \"type\": \"object\",\n68\t                \"properties\": {\n69\t                    \"path\": {\n70\t                        \"type\": \"string\",\n71\t                        \"description\": \"保存路径（绝对路径），例如 C:\\\\Tests\\\\MySequence.seq\",\n72\t                    },\n73\t                },\n74\t                \"required\": [\"path\"],\n75\t            },\n76\t        ),\n77\t        Tool(\n78\t            name=\"ts_close_sequence_file\",\n79\t            description=\"关闭当前序列文件并释放资源。完成后如需新建文件，请重新调用 ts_create_sequence_file。\",\n80\t            inputSchema={\n81\t                \"type\": \"object\",\n82\t                \"properties\": {},\n83\t                \"required\": [],\n84\t            },\n85\t        ),\n86\t\n87\t        # ── 步骤操作 ──\n88\t        Tool(\n89\t            name=\"ts_add_step\",\n90\t            description=\"向当前序列当前步骤组添加一个步骤。\\n\\n常用步骤类型:\\n- Action: 调用代码模块（VI/DLL/.NET）\\n- NumericLimitTest: 数值比较测试\\n- StringValueTest: 字符串比较测试\\n- MessagePopup: 消息弹窗\\n- SequenceCall: 调用子序列\\n- Statement: 执行表达式\\n- Wait: 等待指定秒数\\n- If/Else/While/For: 流程控制\\n\\n如需绑定代码模块，请使用 ts_add_action。\",\n91\t            inputSchema={\n92\t                \"type\": \"object\",\n93\t                \"properties\": {\n94\t                    \"step_type\": {\n95\t                        \"type\": \"string\",\n96\t                        \"description\": \"步骤类型名\",\n97\t                    },\n98\t                    \"name\": {\n99\t                        \"type\": \"string\",\n100\t                        \"description\": \"步骤名称（可选，默认自动生成）\",\n101\t               